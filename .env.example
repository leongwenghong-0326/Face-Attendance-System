# Application Environment Configuration
APP_NAME="Apex Facial Attendance System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/face_attendance_system/public
APP_TIMEZONE=Asia/Kuala_Lumpur

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=face_attendance_db
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Upload Limits
MAX_UPLOAD_SIZE_MB=5
ALLOWED_DOCUMENT_TYPES=pdf,jpg,jpeg,png
ALLOWED_DOCUMENT_MIMES=application/pdf,image/jpeg,image/png

# Face Recognition Settings
FACE_MODEL_PATH=/assets/models
DUPLICATE_SCAN_INTERVAL=300
FACE_MATCH_THRESHOLD=0.55
MIN_ATTENDANCE_CONFIDENCE=0.45
